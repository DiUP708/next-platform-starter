# Trillian Studio — Agent Config
# Fill in the values marked <<FILL IN>>

GOOGLE_PLACES_API_KEY=        # leave blank to use leads_seed.csv
ANTHROPIC_API_KEY=            # optional, for email personalization
TELEGRAM_BOT_TOKEN=           # <<FILL IN>> from @BotFather
TELEGRAM_CHAT_ID=             # <<FILL IN>> your personal chat ID

SENDER_NAME=Arvīds
CALCOM_URL=                   # <<FILL IN>> e.g. https://cal.com/arvids/30min
PORTFOLIO_URL=                # <<FILL IN>> link to your best demo
BASE_DEMO_URL=http://localhost:8000/demos  # update when deployed

SEND_MODE=draft               # draft | approve | api
DAILY_SEND_CAP=30
BUDGET_USD_PER_DAY=5

VPS_DEPLOY_TARGET=            # <<FILL IN>> user@host:/var/www/demos
