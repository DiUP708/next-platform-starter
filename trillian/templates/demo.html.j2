<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{{ name }} — {{ city }}, {{ state }}</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      theme: {
        extend: {
          colors: {
            primary:   '{{ primary }}',
            accent:    '{{ accent }}',
            dark:      '{{ dark }}',
            light:     '{{ light }}',
          }
        }
      }
    }
  </script>
  <style>
    [x-cloak]{display:none}
    html{scroll-behavior:smooth}
    .hero-bg{background: linear-gradient(135deg, {{ dark_hex }} 0%, {{ primary_hex }} 100%);}
    .btn-accent{background-color:{{ accent_hex }};color:#fff;font-weight:700;border-radius:0.375rem;padding:0.875rem 2rem;transition:opacity .2s;}
    .btn-accent:hover{opacity:.88}
    .btn-outline{border:2px solid {{ accent_hex }};color:{{ accent_hex }};font-weight:700;border-radius:0.375rem;padding:0.8rem 1.8rem;transition:background .2s,color .2s;}
    .btn-outline:hover{background:{{ accent_hex }};color:#fff;}
    .section-title{color:{{ primary_hex }};font-size:1.875rem;font-weight:800;line-height:1.2;}
    .card{border-top:4px solid {{ accent_hex }};}
    .star{color:#f59e0b;}
  </style>
</head>
<body class="font-sans antialiased bg-gray-50 text-gray-800">

<!-- ═══ HERO ═══ -->
<header class="hero-bg text-white">
  <nav class="max-w-6xl mx-auto flex items-center justify-between px-6 py-4">
    <span class="text-xl font-extrabold tracking-tight">{{ name }}</span>
    <a href="tel:{{ phone }}" class="btn-accent text-sm px-5 py-2">Call Now</a>
  </nav>
  <div class="max-w-6xl mx-auto px-6 pt-16 pb-20 text-center md:text-left">
    <p class="text-sm uppercase tracking-widest mb-3 opacity-75">{{ city }}, {{ state }}</p>
    <h1 class="text-4xl md:text-6xl font-extrabold leading-tight mb-6">
      {{ tagline }}
    </h1>
    <p class="text-lg md:text-xl opacity-85 mb-10 max-w-xl mx-auto md:mx-0">
      Trusted by {{ city }}-area homeowners. Licensed, insured, and ready to protect your home.
    </p>
    <div class="flex flex-col sm:flex-row gap-4 justify-center md:justify-start">
      <a href="#quote" class="btn-accent text-base">Get a Free Quote</a>
      <a href="tel:{{ phone }}" class="btn-outline text-base" style="border-color:#fff;color:#fff;" onmouseover="this.style.background='#fff';this.style.color='{{ primary_hex }}'" onmouseout="this.style.background='transparent';this.style.color='#fff'">
        ☎ {{ phone }}
      </a>
    </div>
  </div>
</header>

<!-- ═══ TRUST BAR ═══ -->
<section class="bg-white border-b border-gray-100 py-8">
  <div class="max-w-6xl mx-auto px-6">
    <div class="grid grid-cols-2 md:grid-cols-4 gap-6 text-center">
      <div>
        <p class="text-3xl font-extrabold" style="color:{{ accent_hex }}">{{ rating }}★</p>
        <p class="text-sm text-gray-500 mt-1">Google Rating</p>
      </div>
      <div>
        <p class="text-3xl font-extrabold" style="color:{{ accent_hex }}">{{ reviews }}+</p>
        <p class="text-sm text-gray-500 mt-1">Happy Customers</p>
      </div>
      <div>
        <p class="text-3xl font-extrabold" style="color:{{ accent_hex }}">✓</p>
        <p class="text-sm text-gray-500 mt-1">Licensed &amp; Insured</p>
      </div>
      <div>
        <p class="text-3xl font-extrabold" style="color:{{ accent_hex }}">Local</p>
        <p class="text-sm text-gray-500 mt-1">to {{ city }}</p>
      </div>
    </div>
  </div>
</section>

<!-- ═══ SERVICES ═══ -->
<section class="py-20 bg-gray-50" id="services">
  <div class="max-w-6xl mx-auto px-6">
    <h2 class="section-title text-center mb-3">Our Services</h2>
    <p class="text-center text-gray-500 mb-12 max-w-xl mx-auto">Everything your home needs — done right, on time, on budget.</p>
    <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-6">
      {% for svc in services %}
      <div class="card bg-white rounded-xl shadow-sm p-7 hover:shadow-md transition-shadow">
        <div class="text-3xl mb-4">{{ svc.icon }}</div>
        <h3 class="font-bold text-lg mb-2" style="color:{{ primary_hex }}">{{ svc.name }}</h3>
        <p class="text-sm text-gray-500">{{ svc.desc }}</p>
      </div>
      {% endfor %}
    </div>
  </div>
</section>

<!-- ═══ WHY US ═══ -->
<section class="py-20" style="background:{{ primary_hex }}">
  <div class="max-w-6xl mx-auto px-6">
    <h2 class="text-center text-3xl font-extrabold text-white mb-3">Why Homeowners Choose {{ name }}</h2>
    <p class="text-center text-white opacity-70 mb-12 max-w-xl mx-auto">We're not the biggest — we're the most careful.</p>
    <div class="grid md:grid-cols-3 gap-8">
      <div class="bg-white bg-opacity-10 rounded-xl p-8 text-white text-center">
        <div class="text-4xl mb-4">🛡️</div>
        <h3 class="font-bold text-lg mb-2">You Don't Pay Unless You Love It</h3>
        <p class="opacity-75 text-sm">If you don't love the first design, you owe us nothing. Zero risk.</p>
      </div>
      <div class="bg-white bg-opacity-10 rounded-xl p-8 text-white text-center">
        <div class="text-4xl mb-4">⚡</div>
        <h3 class="font-bold text-lg mb-2">7-Day Turnaround</h3>
        <p class="opacity-75 text-sm">From signed contract to live website in one week — not one month.</p>
      </div>
      <div class="bg-white bg-opacity-10 rounded-xl p-8 text-white text-center">
        <div class="text-4xl mb-4">📞</div>
        <h3 class="font-bold text-lg mb-2">Built to Get More Calls</h3>
        <p class="opacity-75 text-sm">Every page, headline, and button is designed to turn visitors into quote requests.</p>
      </div>
    </div>
  </div>
</section>

<!-- ═══ REVIEWS ═══ -->
<section class="py-20 bg-white" id="reviews">
  <div class="max-w-6xl mx-auto px-6">
    <h2 class="section-title text-center mb-3">What Customers Say</h2>
    <p class="text-center text-gray-500 mb-12">{{ rating }}★ on Google · {{ reviews }}+ verified reviews</p>
    <div class="grid md:grid-cols-3 gap-6">
      <!-- PLACEHOLDER TESTIMONIALS — replace with real customer quotes before launch -->
      <div class="bg-gray-50 rounded-xl p-7 border border-gray-100">
        <div class="flex mb-3">
          <span class="star text-xl">★★★★★</span>
        </div>
        <p class="text-gray-700 italic mb-4">"[PLACEHOLDER — add a real customer quote here. Example: 'Great work, fast and professional. Would highly recommend to anyone in {{ city }}!']"</p>
        <p class="font-semibold text-sm" style="color:{{ primary_hex }}">— Happy Customer in {{ city }}, {{ state }}</p>
      </div>
      <div class="bg-gray-50 rounded-xl p-7 border border-gray-100">
        <div class="flex mb-3">
          <span class="star text-xl">★★★★★</span>
        </div>
        <p class="text-gray-700 italic mb-4">"[PLACEHOLDER — add a real customer quote here. Example: 'Called them in the morning, they had someone out by noon. Fair price and zero mess left behind.']"</p>
        <p class="font-semibold text-sm" style="color:{{ primary_hex }}">— Satisfied Homeowner, {{ city }}</p>
      </div>
      <div class="bg-gray-50 rounded-xl p-7 border border-gray-100">
        <div class="flex mb-3">
          <span class="star text-xl">★★★★★</span>
        </div>
        <p class="text-gray-700 italic mb-4">"[PLACEHOLDER — add a real customer quote here. Example: 'Best decision we made for our home. Professional from start to finish.']"</p>
        <p class="font-semibold text-sm" style="color:{{ primary_hex }}">— Verified Customer, {{ state }}</p>
      </div>
    </div>
    <p class="text-center text-xs text-gray-400 mt-6">* Testimonial placeholders — replace with real reviews from {{ name }}'s Google Business profile.</p>
  </div>
</section>

<!-- ═══ QUOTE FORM ═══ -->
<section class="py-20 bg-gray-50" id="quote">
  <div class="max-w-2xl mx-auto px-6">
    <h2 class="section-title text-center mb-3">Get Your Free Quote</h2>
    <p class="text-center text-gray-500 mb-10">No obligation. We'll get back to you within a few hours.</p>
    <!-- DEMO FORM — in production, wire to your CRM or a form service (e.g. Netlify Forms, Formspree). Currently uses a mailto fallback. -->
    <form action="mailto:{{ phone }}?subject=Quote Request from Website" method="get" enctype="text/plain" class="bg-white rounded-2xl shadow-md p-8 space-y-5">
      <div>
        <label class="block text-sm font-semibold text-gray-700 mb-1">Your Name</label>
        <input type="text" name="name" placeholder="Jane Smith" class="w-full border border-gray-200 rounded-lg px-4 py-3 focus:outline-none focus:ring-2 text-gray-800" style="--tw-ring-color:{{ accent_hex }}" />
      </div>
      <div>
        <label class="block text-sm font-semibold text-gray-700 mb-1">Phone Number</label>
        <input type="tel" name="phone" placeholder="(555) 000-0000" class="w-full border border-gray-200 rounded-lg px-4 py-3 focus:outline-none focus:ring-2 text-gray-800" />
      </div>
      <div>
        <label class="block text-sm font-semibold text-gray-700 mb-1">Address</label>
        <input type="text" name="address" placeholder="{{ city }}, {{ state }}" class="w-full border border-gray-200 rounded-lg px-4 py-3 focus:outline-none focus:ring-2 text-gray-800" />
      </div>
      <div>
        <label class="block text-sm font-semibold text-gray-700 mb-1">What do you need?</label>
        <textarea name="message" rows="3" placeholder="Describe your project…" class="w-full border border-gray-200 rounded-lg px-4 py-3 focus:outline-none focus:ring-2 text-gray-800 resize-none"></textarea>
      </div>
      <button type="submit" class="btn-accent w-full text-center text-base">Send My Request →</button>
    </form>
    <p class="text-center mt-6 text-gray-500">Or call us directly: <a href="tel:{{ phone }}" class="font-bold" style="color:{{ accent_hex }}">{{ phone }}</a></p>
  </div>
</section>

<!-- ═══ FOOTER ═══ -->
<footer style="background:{{ dark_hex }}" class="text-white py-12">
  <div class="max-w-6xl mx-auto px-6 flex flex-col md:flex-row items-center justify-between gap-6 text-center md:text-left">
    <div>
      <p class="font-extrabold text-lg">{{ name }}</p>
      <p class="opacity-60 text-sm mt-1">{{ city }}, {{ state }} · <a href="tel:{{ phone }}" class="underline opacity-80">{{ phone }}</a></p>
      <p class="opacity-40 text-xs mt-2">Licensed &amp; Insured · Serving {{ city }} &amp; Surrounding Areas</p>
    </div>
    <div class="text-xs opacity-40 text-center">
      <p>Demo built by <a href="https://trillian.studio" class="underline" target="_blank">Trillian Studio</a></p>
      <p>This is a design preview. Content and photos are placeholders until you go live.</p>
    </div>
  </div>
</footer>

</body>
</html>
